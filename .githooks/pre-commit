#!/usr/bin/env bash
set -euo pipefail

# Revisa únicamente los archivos staged para este commit.
# Esto mantiene la regla local sin bloquear archivos de terceros o generados.

python - <<'PY'
import subprocess
import sys
from pathlib import Path

repo = Path('.').resolve()
result = subprocess.run(
    ['git', 'diff', '--cached', '--name-only', '--diff-filter=ACMR'],
    cwd=repo,
    capture_output=True,
    text=True,
    check=True,
)

files = [line.strip() for line in result.stdout.splitlines() if line.strip()]
if not files:
    sys.exit(0)

# Se usa el checker con una lista de paths y se ignora lo que no sea de código propio.
subprocess.run(['python', 'scripts/check_headers.py', *files], cwd=repo, check=True)
PY
